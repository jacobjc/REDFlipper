{
  "id": "com.jacobchristiansen.redflip",
  "name": "REDFlipper",
  "version": "2.4.6",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "extensions": [
        ""
      ]
    }
  },
  "entrypoints": [
    {
      "id": "redflip",
      "type": "panel",
      "label": {
        "default": "REDFlipper"
      },
      "minimumSize": {
        "width": 700,
        "height": 450
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 700,
        "height": 450
      },
      "preferredFloatingSize": {
        "width": 700,
        "height": 450
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "all"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}
